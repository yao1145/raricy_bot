# 文档：归档与 AI 约定不入库，其余 docs/ 正常入库
docs/archive/
CLAUDE.md
AGENTS.md
docs/materials/logos_presentation

# 知识库（按要求不入库）
knowledge/

# 博客草稿（按要求不入库）
drafts/

# 测试（按要求不入库）
tests/

# Python 缓存与构建产物
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.eggs/

# 运行期数据：SQLite 是本地状态，且带 -wal/-shm 兄弟文件
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
data/

# 本地配置与密钥。可入库的配置只有 config.example.yaml
config.yaml
# `.env` 的其余写法（`.env.local`、`.env.production`…）同样只在本机存在。
# 单独豁免 `.env.example`：那是不含真实值的模板。
.env
.env.*
!.env.example
# 常见的凭据备份与导出文件名：它们通常不会被误认为配置，因此更该列出来。
*.pem
*.key
credentials.json
service-account*.json

# 运行期日志与永久归档。归档按设计只增不减，绝不能进版本库：
# 它一旦入库，历史里的每一条错误都会永久留在 Git 对象里，删不掉。
logs/
*.jsonl

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
Desktop.ini

# Claude Code 的隔离工作树：它整个是仓库的一份副本，不忽略的话
# 一次 `git add -A` 就会把整棵树（含未提交的源码）当新文件加进来。
.claude/worktrees/
